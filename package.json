{
  "name": "bitor-quest",
  "private": true,
  "version": "0.1.0",
  "description": "A solo role-playing game narrated by Claude, played on your own API key.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "phone": "npm run build && vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "playtest": "vitest run tests/playtest.test.ts --reporter=verbose",
    "playtest:long": "vitest run tests/long.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "dexie": "^4.4.7",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
